meta {
  name: 03 Get session events
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/internal/agentsdk/deployments/{{slug}}/sessions/{{sessionId}}/events?teamId={{teamId}}&afterEventIndex=-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cursorApiKey}}
}

docs {
  Poll until you see message.completed / turn.completed.
  Assistant text is under events[].data for type message.completed.
}
